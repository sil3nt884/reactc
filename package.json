{
  "name": "reactc-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Builds reactc, a compiler from React (TSX/JSX) user interfaces and Node servers to native Windows and Linux executables, and its libraries.",
  "type": "module",
  "workspaces": [
    "packages/reactc-ui",
    "packages/reactc-threads"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:compiler": "node scripts/build-compiler.mjs",
    "new-app": "node scripts/new-app.mjs",
    "test": "node scripts/check-thread-clone.mjs && node scripts/check-node-win32-path.mjs",
    "test:compiler": "cargo test --locked --manifest-path compiler/Cargo.toml",
    "check:threads": "node scripts/check-reactc-threads.mjs",
    "check:shared-threads": "node scripts/check-reactc-shared-threads.mjs",
    "check:node-api": "node scripts/check-node-api-probe.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
