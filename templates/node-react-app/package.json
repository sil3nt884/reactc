{
  "name": "node-react-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Node HTTP API and a React client, compiled by reactc into native executables for Windows and Linux.",
  "scripts": {
    "build": "node scripts/reactc.mjs build",
    "build:windows": "node scripts/reactc.mjs build --target windows",
    "build:linux": "node scripts/reactc.mjs build --target linux",
    "build:server": "node scripts/reactc.mjs build --only server",
    "build:client": "node scripts/reactc.mjs build --only client",
    "start": "node scripts/reactc.mjs start",
    "dev:server": "node server/index.ts",
    "test": "node --test server/*.test.ts shared/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@reactc/threads": "file:../../packages/reactc-threads",
    "@reactc/ui": "file:../../packages/reactc-ui"
  }
}
